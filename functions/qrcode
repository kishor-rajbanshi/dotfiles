# shellcheck shell=sh

_qrcode_show_message() {
	echo "Type or paste your text, add a new blank line, and press ^d"
}

qrcode() {
	_i="$*"
	[ -z "$_i" ] && _qrcode_show_message && _i="@/dev/stdin"
	curl -d "$_i" https://qrcode.show
}

qrsvg() {
	_i="$*"
	[ -z "$_i" ] && _qrcode_show_message && _i="@/dev/stdin"
	curl -d "$_i" https://qrcode.show -H "Accept: image/svg+xml"
}

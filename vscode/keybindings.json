// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+s",
        "command": "tailwindCSS.sortSelection",
        "when": "editorHasSelection && tailwindCSS.activeTextEditorSupportsClassSorting && resourceScheme == 'file' || editorHasSelection && tailwindCSS.activeTextEditorSupportsClassSorting && resourceScheme == 'vscode-remote'"
    }
]

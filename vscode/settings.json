    "github.copilot.chat.reviewSelection.instructions": [
        {
            "text": "Flag bugs, logic errors, and edge cases that aren't handled."
        },
        {
            "text": "Point out security issues (e.g. unvalidated input, injection risks, exposed secrets)."
        },
        {
            "text": "Note deviations from established conventions in this codebase (naming, structure, error handling)."
        },
        {
            "text": "Suggest improvements for readability or maintainability, but don't nitpick style if a linter/formatter already enforces it."
        },
        {
            "text": "Be concise — comment only where it adds value, skip praise and filler."
        }
    ],

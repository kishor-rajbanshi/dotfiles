    "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
        {
            "text": "Structure the PR description with these sections: ## Summary, ## Changes, ## Testing."
        },
        {
            "text": "In Summary, briefly explain the purpose/motivation of the PR in 1-3 sentences."
        },
        {
            "text": "In Changes, use a bullet list of the key changes made, grouped logically if there are many."
        },
        {
            "text": "In Testing, describe how the changes were verified (manual steps, test cases, or note if none were added)."
        },
        {
            "text": "Keep the tone concise and factual; avoid restating the diff line by line."
        }
    ],

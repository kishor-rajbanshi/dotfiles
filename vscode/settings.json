    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Follow Conventional Commits: <type>(<scope>): <subject>. Types: feat, fix, docs, style, refactor, perf, test, chore, build, ci."
        },
        {
            "text": "Subject line in imperative mood, lowercase, no trailing period, max 72 characters."
        },
        {
            "text": "If the change is non-trivial, add a blank line then a concise body explaining what and why, wrapped at 100 characters."
        },
        {
            "text": "Do not include file names or line numbers in the subject; summarize the intent of the change instead."
        }
    ],

# shellcheck disable=all

_dir_completion() { _path_files -W "$1" -/; }
compdef "_dir_completion $HOME" hm
compdef "_dir_completion $HOME/Codespace" cs
compdef "_dir_completion /var/www" www

_dot_completion() {
	((CURRENT == 2)) || return 0

	local dots="${words[1]}"
	local levels=$((${#dots} - 1))
	local target="$PWD"
	local i

	for ((i = 0; i < levels; i++)); do
		target="${target:h}"
	done

	[[ -d "$target" ]] || return 0
	_path_files -W "$target" -/
}
compdef _dot_completion .. ... .... ..... ......

_artisan_complete() {
	[[ -f artisan ]] && ((CURRENT == 2)) || return

	local -a commands
	commands=(${(f)"$(php artisan list --raw 2>/dev/null | awk -v p="${1:+$1:}" 'substr($1, 1, length(p)) == p { print substr($1, length(p) + 1) }')"})

	compadd -- $commands
}
compdef _artisan_complete a
compdef "_artisan_complete make" am
compdef "_artisan_complete migrate" amg

_olo_complete() {
	((CURRENT == 2)) || return 1
	local -a models
	models=(${(f)"$(ollama ls 2>/dev/null | awk 'NR > 1 { print $1 }')"})
	compadd -a models
}
compdef _olo_complete olo

_gsw_complete() {
	((CURRENT == 2)) || return 1
	local -a branches
	branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
	compadd -a branches
}
compdef _gsw_complete gsw

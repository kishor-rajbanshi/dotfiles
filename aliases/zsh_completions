# shellcheck disable=all

_dot_completion() {
	((CURRENT == 2)) || return 0

	local dots="${words[1]}"
	local levels=$((${#dots} - 1))
	local target="$PWD"
	local i

	for ((i = 0; i < levels; i++)); do
		target="${target:h}"
	done

	[[ -d "$target" ]] || return 0
	_path_files -W "$target" -/
}
compdef _dot_completion .. ... .... .....

_dir_completion() { _path_files -W "$1" -/; }
compdef "_dir_completion $HOME" home
compdef "_dir_completion $HOME/Codespace" cs
compdef "_dir_completion /var/www" www

_bln_completion() {
	((CURRENT == 2)) || return 0

	local -a formulae
	formulae=(${(f)"$(brew list --formula -1 2>/dev/null)"})
	compadd -a formulae
}
(($+commands[brew])) && compdef _bln_completion bln

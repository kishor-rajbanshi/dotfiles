# shellcheck shell=bash

_dir_completion() {
	local base cur=${COMP_WORDS[COMP_CWORD]} d
	case ${COMP_WORDS[0]} in
	hm) base=$HOME ;;
	cs) base=$HOME/Codespace ;;
	www) base=/var/www ;;
	*) return 0 ;;
	esac

	while IFS= read -r d; do
		COMPREPLY+=("${d#"$base"/}/")
	done < <(compgen -d -- "$base/$cur")
}
complete -o nospace -F _dir_completion hm cs www

_dot_completion() {
	[[ $COMP_CWORD -eq 1 ]] || return 0

	local target=$PWD cur=${COMP_WORDS[COMP_CWORD]} d i
	for ((i = 1; i < ${#COMP_WORDS[0]}; i++)); do
		target=${target%/*}
	done

	local base=${target%/}
	while IFS= read -r d; do
		COMPREPLY+=("${d#"$base"/}/")
	done < <(compgen -d -- "$base/$cur")
}
complete -o nospace -F _dot_completion .. ... .... ..... ......

_artisan_completion() {
	local line=${COMP_LINE:0:COMP_POINT} cur pre ns c
	[[ -f artisan && $line == *' '* && ${line% *} != *' '* ]] || return 0
	cur=${line##* }
	pre=${cur%"${cur##*:}"}
	case $1 in am) ns=make: ;; amg) ns=migrate: ;; esac

	while IFS= read -r c; do
		COMPREPLY+=("$c")
	done < <(php artisan list --raw 2>/dev/null |
		awk -v p="$ns$cur" -v n=$((${#ns} + ${#pre})) 'substr($1, 1, length(p)) == p { print substr($1, n + 1) }')
}
complete -F _artisan_completion a am amg

_olo_completion() {
	local line=${COMP_LINE:0:COMP_POINT} cur pre c
	[[ $line == *' '* && ${line% *} != *' '* ]] || return 0
	cur=${line##* }
	pre=${cur%"${cur##*:}"}

	while IFS= read -r c; do
		COMPREPLY+=("$c")
	done < <(ollama ls 2>/dev/null |
		awk -v p="$cur" -v n=${#pre} 'NR > 1 && substr($1, 1, length(p)) == p { print substr($1, n + 1) }')
}
complete -F _olo_completion olo

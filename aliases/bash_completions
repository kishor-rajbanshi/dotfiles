# shellcheck shell=bash

_dot_completion() {
	[[ $COMP_CWORD -eq 1 ]] || return 0

	local target=$PWD cur=${COMP_WORDS[COMP_CWORD]} d i
	for ((i = 1; i < ${#COMP_WORDS[0]}; i++)); do
		target=${target%/*}
	done

	local base=${target%/}
	while IFS= read -r d; do
		COMPREPLY+=("${d#"$base"/}/")
	done < <(compgen -d -- "$base/$cur")
}
complete -o nospace -F _dot_completion .. ... .... .....

_dir_completion() {
	local base cur=${COMP_WORDS[COMP_CWORD]} d
	case ${COMP_WORDS[0]} in
	home) base=$HOME ;;
	cs) base=$HOME/Codespace ;;
	www) base=/var/www ;;
	*) return 0 ;;
	esac

	while IFS= read -r d; do
		COMPREPLY+=("${d#"$base"/}/")
	done < <(compgen -d -- "$base/$cur")
}
complete -o nospace -F _dir_completion home cs www

_bln_completion() {
	[[ $COMP_CWORD -eq 1 ]] || return 0

	local cur=${COMP_WORDS[COMP_CWORD]} f
	while IFS= read -r f; do
		COMPREPLY+=("$f")
	done < <(compgen -W "$(brew list --formula -1 2>/dev/null)" -- "$cur")
}
complete -F _bln_completion bln

_am_completion() {
	[[ -f artisan && $COMP_CWORD -eq 1 ]] || return 0

	local cur=${COMP_WORDS[COMP_CWORD]} c
	local commands
	commands=$(php artisan list --raw 2>/dev/null | awk '/^make:/{sub(/^make:/, "", $1); print $1}')

	while IFS= read -r c; do
		COMPREPLY+=("$c")
	done < <(compgen -W "$commands" -- "$cur")
}
complete -F _am_completion am

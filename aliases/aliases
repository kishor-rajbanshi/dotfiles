# shellcheck shell=sh

# Navigation
# shellcheck disable=SC3033
..() { cd "..${1:+/$1}" || return; }
...() { cd "../..${1:+/$1}" || return; }
....() { cd "../../..${1:+/$1}" || return; }
.....() { cd "../../../..${1:+/$1}" || return; }
home() { cd "$HOME/${1:-}" || return; }
cs() { cd "$HOME/Codespace/${1:-}" || return; }
www() { cd "/var/www/${1:-}" || return; }

# Terminal
alias cls="clear"
alias prm="/bin/rm -rf"

# Homebrew
alias b="brew"
alias bcau="brew cleanup && brew autoremove && brew update && brew upgrade"
alias bi="brew install"
alias bu="brew uninstall --zap"
alias bls="brew list"
alias bs="brew services"
alias bsls="brew services list"
alias bss="brew services start"
alias bsr="brew services restart"
alias bsst="brew services stop"
bln() { brew link "$1" --force --overwrite; }
alias buln="brew unlink"

# PHP
alias p="php"
alias pv="php -v"
psl() { php -S localhost:"${1:-}"; }
psb() { php -S 0.0.0.0:"${1:-}"; }

# Composer
alias c="composer"
alias cup="composer update"
alias cgu="composer global update"
alias ci="composer install"
alias cr="composer require"
alias crd="composer require --dev"
alias crm="composer remove"
alias cdev="composer dev"

# Laravel Artisan
alias a="php artisan"
# shellcheck disable=SC3057
am() { php artisan make:"$1" "${@:2}"; }

# Ollama
alias o="ollama"
alias ols="ollama ls"
alias ops="ollama ps"
alias orm="ollama rm"
alias or="ollama run"
alias os="ollama stop"
alias op="ollama pull"
alias ol="ollama launch"
olo() { ollama launch opencode ${1:+--model=$1}; }

# Npm
alias n="npm"
alias nup="npm update"
alias ni="npm install"
alias nid="npm install --save-dev"
alias nu="npm uninstall"
alias nr="npm run"
alias nrd="npm run dev"
alias nrb="npm run build"
alias nrt="npm run test"

# Git
alias g="git"
alias gst="git status"
alias gl="git log"
alias glo="git log --oneline"
alias gf="git fetch"
alias gfp="git fetch --prune"
alias gb="git branch"
alias gba="git branch -a"
alias gpu="git pull"
alias gp="git push"
alias gpf="git push -f"
alias gpt="git push --tags"
gps() { git push --set-upstream "${1:-origin}" "${2:-$(git branch --show-current)}"; }
alias gc="git clone"
alias gs="git switch"
alias gsc="git switch -c"
ga() { git add "${@:-.}"; }
gcm() { git commit -m "${*:-WIP}"; }
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"
gcln() { git clean "-${1:-fdx}"; }
gr() { git restore "${@:-.}"; }
grs() { git restore --staged "${@:-.}"; }
grsw() { git restore --staged --worktree "${@:-.}"; }
alias gwl="git worktree list"
alias gwa="git worktree add"
alias gwr="git worktree remove"
alias gwp="git worktree prune"
alias gsh="git stash"
alias gshls="git stash list"
alias gsha="git stash apply"
alias gshp="git stash pop"
alias gshd="git stash drop"

# Docker

alias d="docker"
alias dc="docker compose"
alias dcw="docker compose watch"
alias dcu="docker compose up"
alias dcud="docker compose up -d"
alias dcd="docker compose down"
alias dcub="docker compose up --build"
alias dcubd="docker compose up --build -d"
alias dsp="docker system prune -a -f --volumes"
alias dr="docker run -it"
alias drr="docker run --rm -it"
alias dcr="docker compose run -it"
alias dcrr="docker compose run --rm -it"
dclean() {
	[ $# -eq 0 ] && set -- civ
	for a in $(echo "$*" | tr -d ' ' | grep -o .); do
		# shellcheck disable=SC2046
		case $a in
		c) docker rm -f $(docker ps -aq) 2>/dev/null ;;
		i) docker rmi -f $(docker images -q) 2>/dev/null ;;
		v) docker volume rm -f $(docker volume ls -q) 2>/dev/null ;;
		esac
	done
}

gsw() {
	if git show-ref --verify --quiet "refs/heads/$1"; then
		git switch "$1"
	else
		printf "Branch '%s' does not exist. Create it? [Y/n] " "$1"
		read -r confirm
		case "$confirm" in
		"" | y | Y | yes | YES | Yes)
			git switch -c "$1"
			;;
		*)
			echo "Cancelled."
			return 1
			;;
		esac
	fi
}
